# ─────────────────────────────────────────────────────────────────────────────
# in-SIGHT database stack – environment variables template
# Copy this file to .env and fill in every value before deploying.
# NEVER commit .env to source control.
# ─────────────────────────────────────────────────────────────────────────────

# Owner / superuser password for the 'insight_owner' PostgreSQL role.
# Used only by the Postgres container itself; not exposed to PostgREST.
POSTGRES_OWNER_PASSWORD=Lakenes101!

# Password for the 'insight_authenticator' role that PostgREST uses to connect.
AUTHENTICATOR_PASSWORD=Lakenes101!

# JWT secret shared between PostgREST and the Nuxt server API routes.
# Must be at minimum 32 characters. Generate with: openssl rand -base64 48
JWT_SECRET=change_me_minimum_32_char_jwt_secret_here_please_use_openssl
